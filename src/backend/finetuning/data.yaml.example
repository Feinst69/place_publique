# ============================================================================
# EXEMPLE POUR UN DATASET CUSTOM (ex: détection de véhicules)
# ============================================================================
# 
# path: /home/user/datasets/vehicles
# train: images/train
# val: images/val
# 
# nc: 3
# names:
#   0: car
#   1: truck
#   2: bus

# ============================================================================
# STRUCTURE DU DATASET ATTENDUE
# ============================================================================
# 
# dataset/
# ├── data.yaml (ce fichier)
# ├── images/
# │   ├── train/
# │   │   ├── image1.jpg
# │   │   ├── image2.jpg
# │   │   └── ...
# │   └── val/
# │       ├── image1.jpg
# │       ├── image2.jpg
# │       └── ...
# └── labels/
#     ├── train/
#     │   ├── image1.txt  (même nom que l'image)
#     │   ├── image2.txt
#     │   └── ...
#     └── val/
#         ├── image1.txt
#         ├── image2.txt
#         └── ...
#
# ============================================================================
# FORMAT DES FICHIERS LABELS (.txt)
# ============================================================================
# 
# Chaque ligne représente un objet détecté:
# <class_id> <x_center> <y_center> <width> <height>
# 
# Où:
# - class_id: ID de la classe (0, 1, 2, ...)
# - x_center, y_center: Coordonnées du centre de la bounding box (normalisées 0-1)
# - width, height: Largeur et hauteur de la bounding box (normalisées 0-1)
# 
# Exemple de fichier label (image1.txt):
# 0 0.5 0.5 0.3 0.4
# 1 0.2 0.3 0.1 0.2
# 2 0.8 0.7 0.15 0.25
# 
# Les coordonnées sont normalisées par rapport à la taille de l'image!
#    x_center = x_pixel / image_width
#    y_center = y_pixel / image_height
#    width = box_width_pixel / image_width
#    height = box_height_pixel / image_height

# ============================================================================
# EXEMPLE POUR PLACE PUBLIQUE (webcam surveillance)
# ============================================================================
# 
# Si vous voulez détecter des personnes, véhicules, etc. sur vos webcams:
# 
