# Configuration YOLO Dataset
# Ce fichier définit la structure de votre dataset pour l'entraînement YOLO

# Chemin racine du dataset (absolu ou relatif)
path: /path/to/your/dataset  # À MODIFIER

# Chemins relatifs vers les images (par rapport à 'path')
train: images/train  # Images d'entraînement
val: images/val      # Images de validation
test: images/test    # Images de test (optionnel)

# Nombre de classes
nc: 80  # À MODIFIER selon votre dataset

# Noms des classes (l'index correspond à l'ID de classe dans les labels)
names:
  0: person
  1: bicycle
  2: car
  3: motorcycle
  4: airplane
  5: bus
  6: train
  7: truck
